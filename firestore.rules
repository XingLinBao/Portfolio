rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() { return request.auth != null && request.auth.uid == 'x3HxqzCj41cdDOy2aTF2MUaBeGH2'; }
    function str(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function num(d, k) { return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] < 100000); }
    function students(d) { return !('students' in d) || (d.students is list && d.students.size() <= 60); }
    function photos(d) { return !('photos' in d) || (d.photos is list && d.photos.size() <= 6); }
    function good(d) {
      return d.keys().size() <= 24 && photos(d)
        && str(d,'title',300) && str(d,'name',300) && str(d,'degree',300) && str(d,'place',300) && str(d,'org',300)
        && str(d,'publisher',300) && str(d,'student',300) && str(d,'venue',300) && str(d,'award',300) && str(d,'type',100)
        && str(d,'group',100) && students(d) && str(d,'materials',500) && str(d,'program',500) && str(d,'desc',3000) && str(d,'link',500) && num(d,'year') && num(d,'month') && num(d,'day') && num(d,'hours') && num(d,'count');
    }
    // Тест тижня: одне запитання = один документ
    function goodQuiz(d) {
      return d.keys().hasOnly(['title','topic','type','code','opts','pairs','explain','ord','createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 1000
        && d.topic in ['html','css','js'] && d.type in ['single','multi','match']
        && str(d,'code',3000) && str(d,'explain',2000)
        && (!('opts' in d) || (d.opts is list && d.opts.size() <= 8))
        && (!('pairs' in d) || (d.pairs is list && d.pairs.size() <= 8));
    }
    // Практика: одна тема = один документ, завдання лежать у масиві tasks
    function goodPractice(d) {
      return d.keys().hasOnly(['title','lang','desc','tasks','ord','createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.lang in ['html','css','js'] && str(d,'desc',1000)
        && d.tasks is list && d.tasks.size() <= 40;
    }
    // Дисципліни: лекції, практичні, самостійне вивчення, додаткова інформація (посилання на файли)
    function ordOk(d) { return !('ord' in d) || d.ord is number; }
    function goodMaterial(d) {
      return d.keys().hasOnly(['disc','kind','title','desc','link','ftype','size','photo','quick','ord','createdAt'])
        && d.disc in ['it','web'] && d.kind in ['lecture','present','practice','self','info']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && str(d,'desc',1000) && str(d,'ftype',40) && str(d,'size',40) && str(d,'photo',900000)
        && d.link is string && d.link.matches('https://.*') && d.link.size() <= 500
        && (!('quick' in d) || d.quick is bool) && ordOk(d);
    }
    // Корисні матеріали: розділи та їхній вміст
    function goodResSection(d) {
      return d.keys().hasOnly(['name','desc','ord','createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && str(d,'desc',500) && ordOk(d);
    }
    function goodResource(d) {
      return d.keys().hasOnly(['section','type','title','desc','link','tag','author','duration','size','ftype','photo','ord','createdAt'])
        && d.section is string && d.section.size() > 0 && d.section.size() <= 100
        && str(d,'type',20) && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && str(d,'desc',1000) && str(d,'tag',60) && str(d,'author',200) && str(d,'duration',20) && str(d,'size',40) && str(d,'ftype',40)
        && str(d,'photo',900000)
        && d.link is string && d.link.matches('https://.*') && d.link.size() <= 500 && ordOk(d);
    }
    // Студентські роботи: назва, категорія, опис, технології, автор, рік, посилання на сайт, скриншот
    function goodWork(d) {
      return d.keys().hasOnly(['title','category','desc','tech','author','year','link','photo','ord','createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && str(d,'category',100) && str(d,'desc',1000) && str(d,'author',200) && num(d,'year')
        && (!('tech' in d) || (d.tech is list && d.tech.size() <= 10))
        && d.link is string && d.link.matches('https://.*') && d.link.size() <= 500
        && str(d,'photo',900000) && ordOk(d);
    }
    // Оголошення: новини та конференції
    function goodAnn(d) {
      return d.keys().hasOnly(['type','title','desc','year','month','day','when','deadline','badge','link','photo','photos','ord','createdAt'])
        && d.type in ['Новина','Конференція']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && str(d,'desc',2000) && str(d,'when',120) && str(d,'deadline',40) && str(d,'badge',80) && str(d,'photo',900000) && photos(d)
        && num(d,'year') && num(d,'month') && num(d,'day')
        && (!('link' in d) || (d.link is string && d.link.size() <= 500 && (d.link == '' || d.link.matches('https://.*'))));
    }
    match /studentWorks/{id} {
      allow read: if true;
      allow create, update: if owner() && goodWork(request.resource.data);
      allow delete: if owner();
    }
    match /materials/{id} {
      allow read: if true;
      allow create, update: if owner() && goodMaterial(request.resource.data);
      allow delete: if owner();
    }
    match /resSections/{id} {
      allow read: if true;
      allow create, update: if owner() && goodResSection(request.resource.data);
      allow delete: if owner();
    }
    match /resources/{id} {
      allow read: if true;
      allow create, update: if owner() && goodResource(request.resource.data);
      allow delete: if owner();
    }
    match /profile/{id} {
      allow read: if true;
      allow write: if owner() && request.resource.data.keys().size() <= 20
        && str(request.resource.data,'about',3000) && str(request.resource.data,'fullName',300)
        && str(request.resource.data,'position',300) && str(request.resource.data,'institution',300)
        && str(request.resource.data,'email',300) && str(request.resource.data,'phone',100)
        && str(request.resource.data,'address',300) && str(request.resource.data,'photo',900000)
        && (!('banners' in request.resource.data) || request.resource.data.banners is map);
    }
    match /quiz/{id} {
      allow read: if true;
      allow create, update: if owner() && goodQuiz(request.resource.data);
      allow delete: if owner();
    }
    match /practice/{id} {
      allow read: if true;
      allow create, update: if owner() && goodPractice(request.resource.data);
      allow delete: if owner();
    }
    match /announcements/{id} {
      allow read: if true;
      allow create, update: if owner() && goodAnn(request.resource.data);
      allow delete: if owner();
    }
    match /{col}/{id} {
      allow read: if col in ['education','subjects','certificates','publications','studentArticles','events','awards'];
      allow create, update: if owner() && col in ['education','subjects','certificates','publications','studentArticles','events','awards'] && good(request.resource.data);
      allow delete: if owner() && col in ['education','subjects','certificates','publications','studentArticles','events','awards'];
    }
  }
}

